<?xml version="1.0"?>
<robot>

    <!-- realsense camera joints -->
    <joint type="fixed" name="front_realsense_chassis_joint">
        <origin xyz="0.25 0.0 0.095" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="front_realsense_chassis" />
    </joint>
    <link name="front_realsense_chassis">
        <visual>
            <origin xyz="-0.15 0.0 -0.075" rpy="${pi/2} 0 ${pi/2}" />
            <geometry>
                <mesh filename="file://$(find quadrotor_description)/meshes/d435.dae"/>
            </geometry>
        </visual>
    </link>

    <joint type="fixed" name="front_realsense_optical_joint">
        <origin xyz="0.025 0.0 0.0" rpy="0 0 0" />
        <parent link="front_realsense_chassis" />
        <child link="front_realsense_optical_link" />
    </joint>
    <link name="front_realsense_optical_link" />


    <gazebo reference="front_realsense_optical_link">
        <sensor name="front_realsense_depth" type="rgbd_camera">
            <pose>0 0 0 0 0 0</pose>
            <camera>
                <horizontal_fov>1.5184351666666667</horizontal_fov>
                <vertical_fov>1.0122901111111111</vertical_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>RGB_INT8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>5</far>
                </clip>
                <distortion>
                    <k1>0.0</k1>
                    <k2>0.0</k2>
                    <k3>0.0</k3>
                    <p1>0.0</p1>
                    <p2>0.0</p2>
                    <center>0.5 0.5</center>
                </distortion>
                <lens>
                    <intrinsics>
                        <fx>554.25469</fx>
                        <fy>554.25469</fy>
                        <cx>320.5</cx>
                        <cy>240.5</cy>
                        <s>0</s>
                    </intrinsics>
                </lens>
                <noise>
                    <type>gaussian</type>
                    <mean>0</mean>
                    <stddev>0.007</stddev>
                </noise>
                <depth_camera>
                    <clip>
                        <near>0.1</near>
                        <far>5</far>
                    </clip>
                </depth_camera>
            </camera>
            <always_on>1</always_on>
            <update_rate>30</update_rate>
            <visualize>true</visualize>
            <topic>quadrotor/realsense</topic>
            <enable_metrics>true</enable_metrics>
            <gz_frame_id>front_realsense_optical_link</gz_frame_id>
        </sensor>
    </gazebo>


</robot>